# Copy this file to .env and fill in the values. Never commit .env.

# Zoho data center domains (India = .in)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_SHEET_API_URL=https://sheet.zoho.in/api/v2

# From https://api-console.zoho.in -> Self Client -> Client Secret tab
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Filled in by running: npm run get-token -- <grant_code>
ZOHO_REFRESH_TOKEN=

# Spreadsheet resource ID: open the sheet at sheet.zoho.in, the URL looks like
# https://sheet.zoho.in/sheet/open/<RESOURCE_ID>
ZOHO_SHEET_RESOURCE_ID=
# Name of the tab inside the spreadsheet (row 1 must contain the headers)
ZOHO_WORKSHEET_NAME=Responses

PORT=3000

# ---- Zoho sign-in (SSO) ----
# From https://api-console.zoho.in -> Add Client -> Server-based Applications
# Redirect URI there must be exactly: <APP_URL>/auth/callback
ZOHO_LOGIN_CLIENT_ID=
ZOHO_LOGIN_CLIENT_SECRET=
# Public address of this form (change when you put it online)
APP_URL=http://localhost:3000
# Optional: only allow these email domains, comma separated (e.g. yourcompany.com)
ALLOWED_EMAIL_DOMAINS=
# Random secret used to sign login cookies
SESSION_SECRET=
